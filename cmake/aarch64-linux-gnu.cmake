set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES DSH_TOOLCHAIN_PREFIX DSH_TARGET_SYSROOT)

set(DSH_TOOLCHAIN_PREFIX "aarch64-linux-gnu" CACHE STRING "Target compiler prefix")
set(DSH_TARGET_SYSROOT "" CACHE PATH "Sysroot for the target vehicle")
set(CMAKE_CXX_COMPILER "${DSH_TOOLCHAIN_PREFIX}-g++")

if(NOT DSH_TARGET_SYSROOT OR NOT IS_DIRECTORY "${DSH_TARGET_SYSROOT}")
    message(FATAL_ERROR "Set DSH_TARGET_SYSROOT to the directory provided by the target SDK")
endif()
set(CMAKE_SYSROOT "${DSH_TARGET_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${DSH_TARGET_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
